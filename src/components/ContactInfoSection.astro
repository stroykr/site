---

const { title } = Astro.props

---

<section class="bs-container bs-mt-lg" id="contacts">

  { title && <h2 class="bs-h2 text-center">{ title }</h2> }

  <div class="mt-8 bg-bs-surface-0/90 p-8 md:p-12 rounded-xl">

    <div class="grid md:grid-cols-2 gap-8 md:gap-12">

      <!-- Левая колонка: телефоны -->
      <div class="flex flex-col items-center md:items-start gap-4">

        <h3 class="text-xl font-semibold">Позвоните нам</h3>

        <div class="flex flex-col gap-3">
          <div>
            <p class="text-sm text-bs-foreground-dark mb-1">Мобильный</p>
            <a href="tel:+79777175252" class="text-2xl font-bold hover:underline">+7 (977) 717-52-52</a>
          </div>
          <div>
            <p class="text-sm text-bs-foreground-dark mb-1">Городской</p>
            <a href="tel:+74959724724" class="text-xl font-semibold hover:underline">+7 (495) 9-724-724</a>
          </div>
        </div>

        <p class="text-sm text-bs-foreground-dark mt-2">Принимаем звонки ежедневно с 9:00 до 20:00</p>

        <button type="button" class="bs-btn mt-2 text-lg px-8 py-4" onclick="demo.showModal()">
          Заказать звонок
        </button>

      </div>

      <!-- Правая колонка: мессенджеры -->
      <div class="flex flex-col items-center md:items-start gap-4">

        <h3 class="text-xl font-semibold">Напишите нам</h3>

        <p class="text-sm text-bs-foreground-dark">Номер для мессенджеров: +7 (925) 482-33-31</p>

        <div class="flex flex-col gap-3">
          <a
            href="https://api.whatsapp.com/send/?phone=79254823331"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-semibold hover:underline flex items-center gap-2"
          >
            <img src="social/whatsapp.svg" alt="WhatsApp" class="h-6 w-6 rounded-lg" />
            WhatsApp
          </a>
          <a
            href="https://t.me/+79254823331"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-semibold hover:underline flex items-center gap-2"
          >
            <img src="social/telegram.svg" alt="Telegram" class="h-6 w-6 rounded-lg" />
            Telegram
          </a>
          <span class="text-lg font-semibold flex items-center gap-2">
            <img src="social/max.svg" alt="Max" class="h-6 w-6 rounded-lg" />
            Max
          </span>
          <a
            href="https://vk.com/stroykomplektremont"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-semibold hover:underline flex items-center gap-2"
          >
            <img src="social/vk.svg" alt="VK" class="h-6 w-6 rounded-lg" />
            VK
          </a>
        </div>

        <p class="text-sm text-bs-foreground-dark mt-2">Отвечаем в мессенджерах ежедневно с 9:00 до 20:00</p>

      </div>

    </div>

  </div>

</section>
