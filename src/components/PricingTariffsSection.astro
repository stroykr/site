---
import Check from '../assets/theme-images/icon-check.svg'

const { title, pricing } = Astro.props
---

<section class="bs-container bs-mt-lg" id="pricing">

  <!-- Header -->
  { title && <h2 class="bs-h2 text-center">{ title }</h2> }

  <!-- Pricing grid -->
  <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    { pricing.map((item, index) =>

    <article
      class:list={[
        '@container p-6 xl:p-8 flex flex-col gap-6 h-full w-full rounded-xl overflow-hidden',
        index === 2
          ? 'bg-white/90 text-black/90 ring-2 ring-amber-400 scale-[1.02]'
          : 'bg-bs-surface-0/90'
      ]}>

      <!-- Content -->
      <div class="relative flex flex-col h-full">

        <!-- Header: Tag + Title -->
        <div class="mb-4">
          { item.tag && <div class="text-xs uppercase tracking-widest font-semibold inline-block rounded-full px-3 py-1 mb-3 border"
            class:list={[
              index === 2
                ? 'bg-amber-400/20 border-amber-400/50 text-amber-900'
                : 'border-bs-foreground-dark/30'
            ]}
            set:html={ item.tag } />
          }
          <h3 class="bs-h3">{ item.title }</h3>
        </div>

        <!-- Description -->
        <div class="bs-body-text text-sm flex-grow mb-4" set:html={ item.content } />

        <!-- Services list -->
        <ul role="list" class="flex flex-col gap-3 my-6">
          { item.services.map(({ item: serviceItem }) =>
            <li class="flex gap-3 items-start">
              <Check height="20" width="20" class="shrink-0 mt-0.5 opacity-70" />
              <span class="text-sm">{ serviceItem }</span>
            </li>
          )}
        </ul>

        <!-- Footer: Price + CTA -->
        <footer class="flex justify-between items-center gap-3 mt-auto pt-4 border-t"
          class:list={[
            index === 2
              ? 'border-black/10'
              : 'border-bs-foreground-dark/10'
          ]}>

          <span class="text-3xl lg:text-4xl font-bold">
            <span class="text-lg font-normal">{ item.pricePrefix }</span>{ item.price.toLocaleString('ru-RU') } <span class="text-lg font-normal">{ item.priceUnit }</span>
          </span>

          <button type="button" class="bs-btn inline-block text-sm" onclick="demo.showModal()">
            { item.cta }
          </button>

        </footer>

      </div>

    </article>
    )}

  </div>

  <!-- Minimal order note -->
  <p class="text-center text-sm text-bs-foreground-dark mt-6">
    Минимальная сумма заказа — 500 000 ₽. Минимальный объём: квартира от 40 м², дом от 100 м².
  </p>

</section>
