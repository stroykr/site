---
const { title, testimonials } = Astro.props
---

<section class="bs-container bs-mt-lg" id="feedback">

  { title && <h2 class="bs-h2 text-center">{ title }</h2> }

  <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

    { testimonials.map((item) =>

    <blockquote class="bg-bs-surface-0/90 p-6 rounded-xl flex flex-col gap-4">

      <p class="bs-body-text text-sm italic leading-relaxed">«{ item.quote }»</p>

      <footer class="mt-auto pt-4 border-t border-bs-foreground-dark/10">
        <cite class="font-semibold not-italic">{ item.handle }</cite>
      </footer>

    </blockquote>
    )}

  </div>

  <!-- CTA after testimonials -->
  <div class="text-center mt-8">
    <button type="button" class="bs-btn" onclick="demo.showModal()">
      Хочу так же — заказать ремонт
    </button>
  </div>

</section>
