---

import Logo from '../assets/theme-images/logo.svg'

const { settings } = Astro.props

---

<header class="wrapper bg-loop font-semibold sticky top-0 z-50 backdrop-blur-md bg-bs-surface-0/40">

  <!-- Wrapper -->
  <div class="bs-container py-4 flex justify-between items-center">

    <!-- Logo -->
    <a class="flex xl:min-w-32 group" href="/" aria-label={ settings.title + ' - Home' }>
      <Logo class="group-hover:scale-90 transition-transform ease-bs-spring duration-1000" height="48" width="160" />
    </a>

    <!-- Nav -->
    <nav class="hidden lg:flex mx-auto self-stretch gap-1 items-start">
      { settings.nav.sort((a, b) => a.order - b.order).map(item =>
        <a class="bs-btn !bg-transparent before:translate-y-full hover:before:translate-y-0" href={item.link}>
          { item.title }
        </a>
      )}
    </nav>

    <!-- Phone + CTA -->
    <div class="flex items-center gap-6">

      <!-- Phone -->
      <a href="tel:+79777175252" class="text-lg font-bold whitespace-nowrap">
        { settings.variables.phoneCallFormatted }
      </a>

      <!-- CTA -->
      <button type="button" class="hidden md:flex min-w-32 bs-btn max-sm:text-sm" onclick="demo.showModal()">
        { settings.dialogModal.cta }
      </button>

    </div>

  </div>

</header>
