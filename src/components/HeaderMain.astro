---

import Logo from '../assets/theme-images/logo.svg'

const { settings } = Astro.props

---

<header class="wrapper bg-loop font-semibold">

  <!-- Wrapper -->
  <div class="bs-container py-6 flex justify-between items-center">

    <!-- Logo -->
    <a class="flex xl:min-w-32 group" href="/" aria-label={ settings.title + ' - Home' }>

      <Logo class="group-hover:scale-90 transition-transform ease-bs-spring duration-1000" height="62" width="200" />

    </a>

    <!-- Nav -->
    <nav class="hidden col-span-6 md:flex mx-auto self-stretch lg:gap-2 items-start">

      <!-- Links -->
      { settings.nav.sort((a, b) => a.order - b.order).map( item => 
        <a class="bs-btn !bg-transparent before:translate-y-full hover:before:translate-y-0" href={item.link}>
          { item.title }
        </a>
      )}

    </nav>

    <!-- CTA -->
    <button type="button" class="hidden xl:flex min-w-32 bs-btn max-sm:text-sm max-sm:text-xs" onclick="demo.showModal()">

      { settings.dialogModal.title }

    </button>

  </div>

</header>
