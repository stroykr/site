---

import Layout from "../layouts/Layout.astro";

import AdvantagesSection from "../components/AdvantagesSection.astro";
import CaseStudiesSection from "../components/CaseStudiesSection.astro";
import ContactInfoSection from "../components/ContactInfoSection.astro";
import CTASection from "../components/CTASection.astro";
import FaqSection from "../components/FaqSection.astro";
import HeroSection from "../components/HeroSection.astro";
import PricingTariffsSection from "../components/PricingTariffsSection.astro";
import ProcessStepsSection from "../components/ProcessStepsSection.astro";
import ServicesCarousel from "../components/ServicesCarousel.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";

import advantages from "../data/advantages.json";
import caseStudies from "../data/case_studies.json";
import faq from "../data/faq.json";
import global_settings from "../data/global_settings.json";
import home from "../data/home.json";
import pricing from "../data/pricing.json";
import process from "../data/process.json";
import services from "../data/services.json";
import testimonials from "../data/testimonials.json";

---

<Layout title={ global_settings.title }>

  <!-- Hero: Заголовок + CTA -->
  <HeroSection
    content={ home.hero_content }
    settings={ global_settings }
    title={ home.hero_title }
  />

  <!-- Услуги: Карусель -->
  <ServicesCarousel
    services={ services }
    title={ home.services_title }
  />

  <!-- Цены: Тарифы -->
  <PricingTariffsSection
    pricing={ pricing }
    title={ home.pricing_title }
  />

  <!-- Процесс работы: 6 шагов -->
  <ProcessStepsSection
    steps={ process }
    title={ home.process_title }
  />

  <!-- Преимущества: 6 блоков -->
  <AdvantagesSection
    advantages={ advantages }
    title={ home.advantages_title }
  />

  <!-- Примеры работ: Кейсы -->
  <CaseStudiesSection
    caseStudies={ caseStudies }
    title={ home.case_studies_title }
  />

  <!-- Отзывы -->
  <TestimonialsSection
    testimonials={ testimonials }
    title={ home.feedback_title }
  />

  <!-- FAQ -->
  <FaqSection
    faq={ faq }
    title={ home.faq_title }
  />

  <!-- Контакты -->
  <ContactInfoSection
    title={ home.contacts_title }
  />

  <!-- Финальный CTA -->
  <CTASection
    content={ home.cta_content }
    title={ home.cta_title }
  />

</Layout>
